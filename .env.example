# Browser-visible Supabase configuration (publishable key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Server runtime configuration (configure in your hosting provider, not in client code)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
# Only if trusted server handlers require admin access; never use a VITE_ prefix:
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SECRET
